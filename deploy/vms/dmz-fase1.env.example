# ConectaEduca — parâmetros NÃO SECRETOS / caminhos de runtime da VM DMZ.
# Copie para um arquivo fora do Git e substitua todos os placeholders.
# O arquivo NÃO é executado como shell pelo preflight.

CONECTAEDUCA_VM_ROLE=dmz
CONECTAEDUCA_VM_ID=CE-UBUNTU-DMZ
CONECTAEDUCA_EXPECTED_HOSTNAME=conectaeduca-dmz
CONECTAEDUCA_EXPECTED_INTERFACE=ALTERAR_INTERFACE
CONECTAEDUCA_EXPECTED_IPV4=192.0.2.10
CONECTAEDUCA_EXPECTED_GATEWAY=192.0.2.1

CONECTAEDUCA_TARGET_PLATFORM=linux/amd64
CONECTAEDUCA_MIN_COMPOSE_VERSION=2.24.4

CONECTAEDUCA_WAF_BIND_ADDRESS=192.0.2.10
CONECTAEDUCA_HTTP_PORT=80
CONECTAEDUCA_HTTPS_PORT=443

# IP ou FQDN real da VM interna, nunca nome de serviço Docker.
CONECTAEDUCA_DB_HOST=192.0.2.20
CONECTAEDUCA_DB_PORT=3306

# Os valores secretos ficam nesses arquivos; não coloque o segredo aqui.
CONECTAEDUCA_DB_PASSWORD_FILE=/caminho/protegido/conectaeduca_db_password
CONECTAEDUCA_PRIVATE_KEY_FILE=/caminho/protegido/conectaeduca_private_key.pem
CONECTAEDUCA_PUBLIC_KEY_FILE=/caminho/protegido/conectaeduca_public_key.pem
CONECTAEDUCA_WAF_TLS_CERT_FILE=/caminho/protegido/waf_tls_cert.pem
CONECTAEDUCA_WAF_TLS_KEY_FILE=/caminho/protegido/waf_tls_key.pem
