# ConectaEduca — parâmetros NÃO SECRETOS / caminhos de runtime da VM interna.
# Copie para um arquivo fora do Git e substitua todos os placeholders.
# O arquivo NÃO é executado como shell pelo preflight.

CONECTAEDUCA_VM_ROLE=interna
CONECTAEDUCA_VM_ID=CE-UBUNTU-INT
CONECTAEDUCA_EXPECTED_HOSTNAME=conectaeduca-interna
CONECTAEDUCA_EXPECTED_INTERFACE=ALTERAR_INTERFACE
# IPv4 da VM e IP do pfSense vêm de /etc/conectaeduca/vms/topologia.env.

CONECTAEDUCA_TARGET_PLATFORM=linux/amd64
CONECTAEDUCA_MIN_COMPOSE_VERSION=2.24.4

CONECTAEDUCA_DB_BIND_ADDRESS=192.0.2.20
CONECTAEDUCA_DB_PORT=3306

CONECTAEDUCA_WAZUH_MANAGER_BIND_ADDRESS=192.0.2.20
CONECTAEDUCA_WAZUH_DASHBOARD_BIND_ADDRESS=192.0.2.20
CONECTAEDUCA_WAZUH_AGENT_PORT=1514
CONECTAEDUCA_WAZUH_ENROLLMENT_PORT=1515
CONECTAEDUCA_WAZUH_DASHBOARD_PORT=443

FERRET_BIND_ADDRESS=127.0.0.1
FERRET_WEB_PORT=18082

# Os valores secretos ficam nesses arquivos; não coloque o segredo aqui.
CONECTAEDUCA_DB_ROOT_PASSWORD_FILE=/caminho/protegido/mariadb_root_password
CONECTAEDUCA_DB_PASSWORD_FILE=/caminho/protegido/conectaeduca_db_password

# OpenBao permanece local à VM interna na fase 1.
CONECTAEDUCA_OPENBAO_BIND_ADDRESS=127.0.0.1
CONECTAEDUCA_OPENBAO_HOST_PORT=18200
