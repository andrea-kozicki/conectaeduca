# ConectaEduca — cartão NÃO SECRETO da implantação fase 1.
# Copie para /etc/conectaeduca/vms/topologia.env nas DUAS Ubuntu.
# Não execute este arquivo como shell.

CONECTAEDUCA_PFSENSE_IPV4=192.0.2.1
CONECTAEDUCA_DMZ_IPV4=192.0.2.10
CONECTAEDUCA_INTERNA_IPV4=192.0.2.20

# Preencher somente DEPOIS do merge final e criação do freeze.
CONECTAEDUCA_BASELINE_COMMIT=ALTERAR_APOS_FREEZE
CONECTAEDUCA_BASELINE_TAG=ALTERAR_APOS_FREEZE
