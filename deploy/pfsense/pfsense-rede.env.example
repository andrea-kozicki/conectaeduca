# ConectaEduca — parâmetros de rede pfSense
# NÃO contém segredos.
# Copie para /tmp/conectaeduca-pfsense.env no pfSense e preencha na terça.

PFSENSE_WAN_IF=''
PFSENSE_DMZ_IF=''
PFSENSE_INTERNA_IF=''

# IPv4 SEM /CIDR, exatamente como configurado nas interfaces.
PFSENSE_WAN_IP=''
PFSENSE_DMZ_IP=''
PFSENSE_INTERNA_IP=''

WAN_GATEWAY=''

VM_DMZ_IP=''
VM_INTERNA_IP=''

# Porta UDP publicada pelo host interno para o receiver syslog do Wazuh.
# Deve permanecer consistente com CONECTAEDUCA_WAZUH_SYSLOG_PORT no runtime.
WAZUH_SYSLOG_PORT='5514'
