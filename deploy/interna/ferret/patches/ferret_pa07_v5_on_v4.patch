+function renderScanCoverageStatus(verdict) {
+    // Keep the coverage verdict beside result totals, even after toast expiry.
+    const canExport = verdict.complete && verdict.findings > 0;
+    const exportButton = document.querySelector('[data-action="exportResults"]');
+    if (exportButton) exportButton.disabled = !canExport;
+    const exportFormat = document.getElementById('exportFormat');
+    if (exportFormat) exportFormat.disabled = !canExport;
+
+    const results = document.getElementById('resultsContainer');
+    const content = results && results.querySelector && results.querySelector('.container-content');
+    if (!content) return;
+    const oldBanner = document.getElementById('ce-results-coverage');
+    if (oldBanner) oldBanner.remove();
+    const banner = document.createElement('div');
+    banner.id = 'ce-results-coverage';
+    banner.className = verdict.complete ? 'alert alert-success' : 'alert alert-warning';
+    banner.setAttribute('role', 'status');
+    banner.setAttribute('aria-live', 'polite');
+    banner.textContent = verdict.complete
+        ? `COMPLETED — ${verdict.succeeded}/${verdict.totalFiles} files scanned; ${verdict.findings} finding(s) observed.`
+          + (canExport ? '' : ' No findings to export.')
+        : `INCONCLUSIVE — ${verdict.succeeded}/${verdict.totalFiles} scan responses accepted; `
+          + `${verdict.failed} failed request(s), ${verdict.incomplete} incomplete scan(s). `
+          + `${verdict.findings} finding(s) observed; more findings may be missing. Export disabled.`;
+    content.insertBefore(banner, content.firstChild);
+}
