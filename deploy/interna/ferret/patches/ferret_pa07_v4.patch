+
+// Persistent, accessible scan verdict, separate from five-second toast notifications.
+function clearPersistentScanStatus() {
+    const previous = document.getElementById('ce-scan-status');
+    if (previous) previous.remove();
+}
+
+function showPersistentScanStatus(message) {
+    const container = document.getElementById('alerts');
+    clearPersistentScanStatus();
+    const status = document.createElement('div');
+    status.id = 'ce-scan-status';
+    status.className = 'alert alert-warning';
+    status.setAttribute('role', 'alert');
+    status.setAttribute('aria-live', 'assertive');
+    status.setAttribute('aria-atomic', 'true');
+    status.textContent = message;
+    container.appendChild(status);
+}
