<group name="conectaeduca,yara,">
  <rule id="110210" level="0">
    <decoded_as>conectaeduca_yara_decoder</decoded_as>
    <description>ConectaEduca YARA: agrupamento de resultados.</description>
  </rule>

  <rule id="110211" level="12">
    <if_sid>110210</if_sid>
    <match>wazuh-yara: INFO - Scan result: </match>
