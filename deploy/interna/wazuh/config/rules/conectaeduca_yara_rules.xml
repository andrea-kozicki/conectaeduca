    <field name="file" type="pcre2">^/var/tmp/conectaeduca-fim-demo-ep125/</field>
    <description>ConectaEduca YARA: arquivo modificado no diretorio sintetico da EP125.</description>
  </rule>

  <rule id="110201" level="7">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">^/var/tmp/conectaeduca-fim-demo-ep125/</field>
    <description>ConectaEduca YARA: arquivo criado no diretorio sintetico da EP125.</description>
  </rule>
