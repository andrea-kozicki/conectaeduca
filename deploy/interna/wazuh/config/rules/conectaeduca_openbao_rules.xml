<group name="conectaeduca,openbao,secrets,audit,">
  <rule id="110400" level="0">
    <decoded_as>json</decoded_as>
    <field name="source" type="pcre2">^openbao-audit$</field>
    <field name="schema_version" type="pcre2">^1$</field>
    <description>ConectaEduca OpenBao: evento de auditoria sanitizado.</description>
  </rule>

  <rule id="110401" level="3">
    <if_sid>110400</if_sid>
    <field name="event_type" type="pcre2">^openbao_audit$</field>
    <description>ConectaEduca OpenBao: operação auditada e sanitizada.</description>
    <options>no_full_log</options>
  </rule>

  <rule id="110402" level="5">
    <if_sid>110401</if_sid>
    <field name="path_class" type="pcre2">^auth_approle_login$</field>
    <description>ConectaEduca OpenBao: autenticação AppRole observada.</description>
    <options>no_full_log</options>
  </rule>

  <rule id="110403" level="7">
    <if_sid>110401</if_sid>
    <field name="path_class" type="pcre2">^kv_smtp$</field>
    <description>ConectaEduca OpenBao: acesso ao segredo SMTP observado.</description>
    <options>no_full_log</options>
  </rule>

  <rule id="110404" level="9">
    <if_sid>110401</if_sid>
    <field name="result" type="pcre2">^(denied|error)$</field>
    <description>ConectaEduca OpenBao: operação negada ou com erro.</description>
    <options>no_full_log</options>
  </rule>

  <rule id="110405" level="12">
    <if_sid>110401</if_sid>
    <field name="path_class" type="pcre2">^sys_generate_root$</field>
    <description>ConectaEduca OpenBao: operação no fluxo generate-root observada.</description>
    <options>no_full_log</options>
  </rule>
</group>
