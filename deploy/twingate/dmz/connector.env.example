# COPIAR LOCALMENTE para connector.env (chmod 600). NUNCA COMMITAR TOKENS.
# TWINGATE_NETWORK e o identificador do TENANT (ex.: nome), NAO 'ConectaEduca - DMZ'.
TWINGATE_NETWORK=SUBSTITUIR_PELO_IDENTIFICADOR_DO_TENANT
TWINGATE_ACCESS_TOKEN=SUBSTITUIR_PELO_TOKEN_DO_CONECTOR_DMZ
TWINGATE_REFRESH_TOKEN=SUBSTITUIR_PELO_REFRESH_TOKEN_DO_CONECTOR_DMZ
