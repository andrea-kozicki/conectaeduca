# Exemplo sem credenciais. Copiar LOCALMENTE para connector.env e chmod 600.
# TWINGATE_NETWORK é o tenant exibido no comando oficial, NÃO o nome da Remote Network.
TWINGATE_NETWORK=SUBSTITUIR_PELO_TENANT
TWINGATE_ACCESS_TOKEN=SUBSTITUIR_PELO_ACCESS_TOKEN
TWINGATE_REFRESH_TOKEN=SUBSTITUIR_PELO_REFRESH_TOKEN
