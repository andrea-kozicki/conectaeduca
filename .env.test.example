# ConectaEduca - ambiente para testes de autenticação local
# Copie para .env.test.local e preencha SOMENTE na máquina de testes.

CE_BASE_URL=https://conectaeduca.local
CE_CURL_INSECURE=1

# Caminhos testados
CE_LOGIN_PATH=/login.php
CE_MFA_PATH=/mfa.php
CE_MFA_CONFIG_PATH=/mfa-configurar.php
CE_DASHBOARD_PATH=/dashboard.php
CE_EMPRESA_PATH=/empresa/oportunidades.php
CE_ADMIN_PATH=/admin/auditoria.php
CE_LOGOUT_PATH=/logout.php

# Nome do cookie PHP seguro utilizado pelo ConectaEduca
CE_SESSION_COOKIE=CONECTAEDUCASESSID

# Usuário comum
CE_TEST_USUARIO_EMAIL=
CE_TEST_USUARIO_SENHA=
CE_TEST_USUARIO_TOTP_SECRET=

# Empresa
CE_TEST_EMPRESA_EMAIL=
CE_TEST_EMPRESA_SENHA=
CE_TEST_EMPRESA_TOTP_SECRET=

# Administrador
CE_TEST_ADMIN_EMAIL=
CE_TEST_ADMIN_SENHA=
CE_TEST_ADMIN_TOTP_SECRET=
