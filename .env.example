# ConectaEduca - exemplo de configuração de ambiente
# Copie para .env somente no ambiente local/deployment.
# Nunca versione credenciais, tokens ou chaves reais.

# --------------------------------------------
# APLICAÇÃO
# --------------------------------------------
APP_ENV=development
APP_DEBUG=false
APP_URL=https://conectaeduca.local

# --------------------------------------------
# BANCO DE DADOS (PDO / MariaDB)
# --------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=conectaeduca
DB_USER=conectaeduca_app
DB_CHARSET=utf8mb4

# Desenvolvimento local: pode usar DB_PASS.
DB_PASS=

# Deployment/container: prefira apontar para um arquivo de secret.
# Se DB_PASS e DB_PASS_FILE coexistirem, DB_PASS tem precedência.
# DB_PASS_FILE=/run/secrets/conectaeduca_db_password

# Na implantação final em duas VMs, DB_HOST deverá apontar para o endereço
# interno da VM de banco, alcançável pela aplicação através do pfSense.

# --------------------------------------------
# E-MAIL (SMTP via PHPMailer)
# --------------------------------------------
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_USERNAME=
# Em implantação real, não armazene a senha SMTP diretamente no .env.
# O segredo deve ser materializado pelo OpenBao/Docker secret e lido por arquivo.
# MAIL_PASSWORD=
MAIL_PASSWORD_FILE=/run/secrets/conectaeduca_smtp_password
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=nao-responda@exemplo.com
MAIL_FROM_NAME="ConectaEduca"

# MAIL_ENCRYPTION=none é reservado a desenvolvimento/teste, com
# MAIL_SMTP_AUTH=false, por exemplo para um capturador SMTP local.

# --------------------------------------------
# CRIPTOGRAFIA HÍBRIDA DA APLICAÇÃO
# --------------------------------------------
# Estas chaves NÃO são JWT. Elas protegem dados da aplicação com
# AES-256-GCM + RSA-OAEP e precisam persistir enquanto houver dados cifrados.
# Caminhos relativos são resolvidos a partir da raiz do projeto.
PRIVATE_KEY_PATH=storage/keys/private.pem
PUBLIC_KEY_PATH=storage/keys/public.pem

# Em containers, os caminhos podem apontar para material montado read-only,
# por exemplo:
# PRIVATE_KEY_PATH=/run/secrets/conectaeduca_private_key
# PUBLIC_KEY_PATH=/run/secrets/conectaeduca_public_key
