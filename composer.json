{
  "name": "andrea-kozicki/conectaeduca",
  "require": {
    "php": "^8.5",
    "ext-filter": "*",
    "ext-hash": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-session": "*",
    "bacon/bacon-qr-code": "^3.1.1",
    "phpmailer/phpmailer": "^7.1",
    "phpseclib/phpseclib": "^3.0",
    "pragmarx/google2fa": "^9.1",
    "vlucas/phpdotenv": "^5.6.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3"
  },
  "autoload": {
    "psr-4": {
      "ConectaEduca\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ConectaEduca\\Tests\\": "tests/"
    }
  },
  "description": "Aplicacao web academica em PHP para oportunidades educacionais, com autenticacao local, controle de acesso, CSRF, criptografia hibrida e auditoria.",
  "license": "proprietary",
  "config": {
    "sort-packages": true,
    "policy": {
      "advisories": {
        "block": true,
        "audit": "fail"
      },
      "abandoned": {
        "block": true,
        "audit": "fail"
      }
    }
  }
}
