{
    "name": "andrea-kozicki/conectaeduca",
    "require": {
        "pragmarx/google2fa": "^8.0",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6",
        "bacon/bacon-qr-code": "^2.0",
        "phpseclib/phpseclib": "^3.0",
        "aws/aws-sdk-php": "^3.384"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "ConectaEduca\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ConectaEduca\\Tests\\": "tests/"
        }
    },
    "description": "Aplicacao web academica em PHP para oportunidades educacionais, com controles de seguranca OWASP, Cognito, JWT, CSRF, criptografia hibrida e auditoria.",
    "license": "proprietary"
}
